// docs: https://help.apple.com/xcode/mac/11.4/#/itcaec37c2a6

#include "base.xcconfig"

// Debug builds are a separate app, "CmdTab Debug", with their own bundle ID: they never share settings,
// permissions or the start-at-login entry with the installed CmdTab. The module name stays CmdTab.
PRODUCT_NAME = CmdTab Debug
PRODUCT_MODULE_NAME = CmdTab
PRODUCT_BUNDLE_IDENTIFIER = com.davidd-t.cmdtab.debug

// Ad-hoc signing, like Release. config/local.xcconfig can switch both to a local certificate (see README).
CODE_SIGN_IDENTITY = -
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG // for macro `#if DEBUG`
OTHER_SWIFT_FLAGS = -driver-time-compilation -Xfrontend -warn-long-function-bodies=250 -Xfrontend -warn-long-expression-type-checking=250 // find slow compilation areas
OTHER_CODE_SIGN_FLAGS = --timestamp=none
SWIFT_COMPILATION_MODE = incremental
ENABLE_DEBUG_DYLIB = NO // skip the debug dylib loader (we don't use SwiftUI Previews); silences [PreviewsAgentExecutorLibrary] startup chatter

// Per-developer overrides (CODE_SIGN_IDENTITY, …).
#include? "local.xcconfig"
